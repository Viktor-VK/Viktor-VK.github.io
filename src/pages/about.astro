---
import Base from '../layouts/Base.astro';
import '../styles/project.css';

const achievements = [
  'Построил отдел аналитики с нуля и вывел на уровень единой точки входа для 14 смежных отделов и топ-менеджмента: 5 аналитиков, 70+ регулярных отчётов, 80%+ автоматизации через Airflow, переработки в команде снижены с 30% до 3%',
  '14+ лет в ритейле (DNS): прошёл всю цепочку товародвижения от склада и логистики до коммерческого управления и аналитики - понимаю бизнес изнутри, а не только по отчётам. Во главе отдела Товарооборот создал алгоритм распределения товара по всей стране.',
  'Разработал модель сегментации 100 000+ SKU для сети из 3 500 магазинов и провёл A/B-эксперимент на 100 торговых точках, подтвердивший рост чистой прибыли на 4,82% при оптимизации ассортимента на горизонте 12 недель',
  'В фармрознице (федеральная сеть, 1000+ аптек) построил кластеризацию точек продаж и метод отбора ассортиментной матрицы по измеримому вкладу товара в продажи - вместо решения «на глаз» категорийного менеджера',
  'Самостоятельно спроектировал и развернул два AI-инструмента промышленного уровня, которые работают в ежедневном режиме: персонального AI-агента для автоматизации поиска подходящих вакансий и end-to-end парсер+дашборд вакансий на собственном VPS',
];

const skillGroups = [
  { label: 'SQL / данные', items: ['ClickHouse', 'Greenplum', 'MS SQL', 'PostgreSQL'] },
  { label: 'Python', items: ['Pandas', 'NumPy', 'Scikit-learn', 'SQLAlchemy'] },
  { label: 'BI / визуализация', items: ['Power BI (DAX)', 'Apache Superset', 'Excel'] },
  { label: 'Автоматизация', items: ['Airflow', 'Telegram-боты', 'алертинг', 'AI-агенты'] },
  { label: '1С', items: ['консольные запросы', 'подключение к реплике MS SQL', 'ТЗ разработчикам'] },
  { label: 'Методы анализа', items: ['кластеризация', 'классификация', 'скоринг', 'A/B-тестирование', 'ABC-анализ', 'поиск аномалий'] },
  { label: 'Процессы', items: ['BPMN', 'Jira', 'Confluence', 'Trello', 'Asana'] },
];

const petProjects = [
  { name: 'C-Djeff (Джеф)', desc: 'персональный AI-агент на Claude Code: ведёт реестр из 700+ вакансий с автооценкой совпадения по 4 критериям, формирует дайджест по Telegram-каналам, интегрирован с Trello и Superset' },
  { name: 'hh_analitics', desc: 'end-to-end инструмент: парсер вакансий hh.ru (Selenium/BeautifulSoup) → база DuckDB → дашборд в Apache Superset, самостоятельно развёрнут на VPS (Docker) с помощью ИИ-ассистента' },
  { name: 'Сайт-портфолио viktor-vk.github.io', desc: 'спроектирован и собран самостоятельно через Claude Code, содержит аналитические кейсы с открытым кодом' },
];

const industries = [
  'Ритейл/e-commerce (DNS): закуп, логистика, коммерческое управление, аналитика и автоматизация',
  'Фармрозница: аналитика ассортимента и ценообразования федеральной аптечной сети',
  'Аналитика и BI для бизнеса (Даталидз): построение аналитической функции с нуля',
];

const education = [
  'Ростовский государственный университет путей сообщения, Ростов-на-Дону, 2006, высшее',
  'Data Science, Skillfactory, 2023',
  '«Дашборд для директора», Институт бизнес-аналитики, 2019',
];
---

<Base
  title="Резюме"
  description="Виктор Кобцев - Senior full-stack аналитик: от сбора и обработки данных до аналитических инструментов под ключ, с практикой внедрения AI-агентов в рабочие процессы."
>
  <article class="project-page">
    <p class="muted crumbs"><a href="/">Главная</a> / резюме</p>
    <span class="eyebrow">Резюме</span>
    <h1>Виктор Кобцев</h1>
    <p class="lead">
      Senior full-stack аналитик: от сбора и обработки данных до аналитических инструментов под ключ, с практикой
      внедрения AI-агентов в рабочие процессы.
    </p>
    <p class="muted">Ростов-на-Дону · удалённо · t.me/Kobcev · kobtsev.victor@yandex.ru</p>

    <div class="actions">
      <a class="btn primary" href="/resume_kobtsev.pdf" download>Скачать резюме (PDF)</a>
      <a class="btn" href="/#contacts">Связаться</a>
    </div>

    <h2>О себе</h2>
    <p>
      9+ лет в аналитике: из них несколько лет - руководителем отдела. Строю аналитику и BI-инфраструктуру с нуля и
      довожу её до высокого уровня автоматизации и измеримого результата. Отдельно развиваю применение ИИ в
      аналитике: создаю персональных AI-агентов для аналитических задач, включая этот сайт-портфолио, который
      спроектировал и собрал самостоятельно через Claude Code. Глубоко разбираюсь в ритейле и e-commerce: знаю
      цепочку товародвижения изнутри от закупа до полки. Готов усилить действующую команду аналитиков, принять
      руководство отделом или полностью закрыть аналитическую функцию в одиночку - в зависимости от того, что нужно
      компании.
    </p>

    <h2>Ключевые достижения</h2>
    <ul class="summary">
      {achievements.map((a) => <li>{a}</li>)}
    </ul>

    <h2>Хард-скиллы</h2>
    {skillGroups.map((g) => (
      <p>
        <strong>{g.label}:</strong> {g.items.join(', ')}
      </p>
    ))}

    <h2>C-Djeff и пет-проекты (практика внедрения AI)</h2>
    <ul class="summary">
      {petProjects.map((p) => (
        <li>
          <strong>{p.name}</strong> - {p.desc}
        </li>
      ))}
    </ul>

    <h2>Отраслевой опыт</h2>
    <ul class="summary">
      {industries.map((i) => <li>{i}</li>)}
    </ul>

    <h2>Образование</h2>
    <ul class="summary">
      {education.map((e) => <li>{e}</li>)}
    </ul>

    <div class="actions">
      <a class="btn primary" href="/resume_kobtsev.pdf" download>Скачать резюме (PDF)</a>
    </div>
  </article>
</Base>
