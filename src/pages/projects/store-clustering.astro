---
import Base from '../../layouts/Base.astro';
import data from '../../data/store-clustering.json';
import matrix from '../../data/assortment-matrix.json';
import '../../styles/project.css';

const codeUrl = 'https://github.com/Viktor-VK/portfolio/tree/master/' + encodeURIComponent('Кластеризация точек продаж');
const synthUrl = 'https://github.com/Viktor-VK/portfolio/tree/master/synthetic_data';
const { meta, quality, segments } = data;
const ex = data.example;
const points = (n: number) =>
  `${n} ${n % 10 === 1 && n % 100 !== 11 ? 'точка' : [2, 3, 4].includes(n % 10) && ![12, 13, 14].includes(n % 100) ? 'точки' : 'точек'}`;

// согласие «локтя» и силуэта по каждой кластеризации - для текста раздела о выборе числа кластеров
const kNames: Record<string, string> = { 'Площадь': 'площади', 'Выручка и чеки': 'деньгам', 'Ценовой профиль': 'цене', 'Ассортиментный профиль': 'ассортименту' };
const kInfo = Object.entries(data.k_selection).map(([name, v]) => {
  const best = v.k[v.silhouette.indexOf(Math.max(...v.silhouette))];
  return { name: kNames[name] ?? name, chosen: v.chosen, best };
});
const kAgree = kInfo.filter((x) => x.chosen === x.best).map((x) => x.name);
const kDiffer = kInfo.filter((x) => x.chosen !== x.best);
const listRu = (xs: string[]) => (xs.length > 1 ? xs.slice(0, -1).join(', ') + ' и ' + xs[xs.length - 1] : xs[0] ?? '');

// архетипы, которые алгоритм разнёс по нескольким сегментам (не меньше 3 точек в каждом)
const R = data.archetypes;
const archLower: Record<string, string> = { 'Аптека в ТЦ': 'аптеки в ТЦ', 'Аптека при ЛПУ': 'аптеки при поликлиниках', 'Аптека у дома': 'аптеки у дома',
  'Дискаунтер': 'дискаунтеры', 'Классическая аптека': 'классические аптеки', 'Премиум-аптека': 'премиум-аптеки',
  'Сельская аптека': 'сельские аптеки', 'Центральная аптека': 'центральные аптеки' };
const split = R.archetypes
  .map((a, j) => ({ a, parts: R.counts.map((row) => row[j]).filter((v) => v >= 3).length }))
  .filter((x) => x.parts > 1)
  .map((x) => `${archLower[x.a] ?? x.a} - на ${x.parts}`);
const whole = R.archetypes.filter((a, j) => R.counts.filter((row) => row[j] > 0).length === 1).map((a) => archLower[a] ?? a);

const num = (x: number, d = 2) => x.toFixed(d).replace('.', ',');
const int = (x: number) => Math.round(x).toLocaleString('ru-RU');
const pct = (x: number) => Math.round(x * 100) + '%';
const thousands = (x: number) => Math.round(x / 1000).toLocaleString('ru-RU') + ' тыс.';
const date = (s: string) => new Date(s).toLocaleDateString('ru-RU', { day: 'numeric', month: 'long' });
const premium = segments.filter((s) => s.segment.includes('премиум'));
const economy = segments.filter((s) => s.segment.includes('эконом'));
const premiumN = premium.map((s) => s.n).reduce((a, b) => a + b, 0);
const economyN = economy.map((s) => s.n).reduce((a, b) => a + b, 0);
const budget = matrix.budget_profit as Record<string, number>;
const sgn = (x: number) => (x > 0 ? '+' : x < 0 ? '-' : '');
const mlnAbs = (x: number) => num(Math.abs(x) / 1e6, 1) + ' млн ₽';
const mlnS = (x: number) => sgn(x) + mlnAbs(x);
const kOrder = ['Площадь', 'Выручка и чеки', 'Ценовой профиль', 'Ассортиментный профиль'];
const kLabel: Record<string, string> = { 'Площадь': 'Площадь', 'Выручка и чеки': 'Деньги', 'Ценовой профиль': 'Цена', 'Ассортиментный профиль': 'Ассортимент' };
---

<Base
  title="Кластеризация точек продаж"
  description="Сегментация аптечной сети по размеру, ассортименту и ценовому позиционированию: автоматическое разбиение точек на понятные бизнес-сегменты."
>
  <article class="project-page">
    <p class="muted crumbs"><a href="/#projects">Проекты</a> / кластеризация точек продаж</p>
    <span class="eyebrow">Проект · Python, SQL, DuckDB, scipy</span>
    <h1>Кластеризация точек продаж аптечной сети</h1>
    <p class="lead">
      Точки одной сети сильно различаются: центральная аптека, аптека у дома, дискаунтер, точка в торговом центре. Единый ассортимент для всех - это излишки в одних точках и упущенная выручка в других. Расчёт делит точки на сегменты с трёх сторон сразу: размер, ассортимент и цены.
    </p>

    <div class="card notice">
      <p>
        <strong>Данные синтетические.</strong> Исходный расчёт выполнен для реальной аптечной сети, её данные публиковать нельзя. Здесь тот же подход воспроизведён на сгенерированной базе: справочник лекарств взят из открытого реестра Минздрава (перечень жизненно необходимых лекарств, ЖНВЛП), точки, чеки и остатки сгенерированы. Цифры не описывают реальный бизнес, но показывают, как работает метод.
      </p>
    </div>

    <section class="card summary">
      <span class="eyebrow">Коротко</span>
      <ul>
        <li><strong>Задача.</strong> Один ассортимент на всю сеть означает излишки в одних точках и упущенную выручку в других. Нужно понять, какие типы точек есть в сети.</li>
        <li><strong>Что сделано.</strong> {meta.stores_used} аптек разбиты на {meta.segments} сегментов по размеру, ассортименту и ценам - полностью автоматически, с понятными названиями вида «{ex.segment}».</li>
        <li><strong>Результат.</strong> Ассортиментные матрицы, построенные по этим сегментам, при тех же деньгах в остатках дают на новых неделях {mlnS(budget['Автосегменты'])} прибыли. Одна матрица на всю сеть при том же бюджете даёт {mlnS(budget['Одна матрица на сеть'])}, текущее деление по площади - {mlnS(budget['Категории A-E'])}. Подробности - на <a href="/projects/assortment-matrix/">странице матрицы</a>.</li>
      </ul>
    </section>

    <dl class="facts">
      <div class="card"><dt>Аптек в расчёте</dt><dd>{meta.stores_used} из {meta.stores_all}</dd></div>
      <div class="card"><dt>Строк чеков за 4 недели</dt><dd>{thousands(meta.lines_kept)}</dd></div>
      <div class="card"><dt>Товаров</dt><dd>{int(meta.products)}</dd></div>
      <div class="card"><dt>Итоговых сегментов</dt><dd>{meta.segments}</dd></div>
    </dl>

    <h2>1. Какие точки попадают в расчёт</h2>
    <p>
      В расчёт идут только аптеки, которые работают не меньше полугода: у новых точек ещё нет устойчивой истории продаж. Формат «оптика» сегментируется отдельно. Из чеков за {date(meta.period_from)} - {date(meta.period_to)} убираются опт, заказы через сторонние маркетплейсы, уценённый товар с коротким сроком годности и нетоварные позиции (пакеты, доставка): остаётся {thousands(meta.lines_kept)} строк из {thousands(meta.lines_all)}
    </p>

    <h2>2. Размер: площадь и деньги</h2>
    <p>
      Размер точки меряется двумя способами: площадью торгового зала и «весом» в деньгах (выручка и число чеков). Их расхождение само по себе сигнал: большая площадь со слабыми продажами или маленькая точка с огромным трафиком. Точки с похожими показателями объединяются в группы (кластеры) алгоритмом иерархической кластеризации.
    </p>
    <figure class="card chart-card">
      <figcaption>
        <strong>Выручка и число чеков точек за 4 недели</strong>
        <span class="muted">Точка на графике - аптека, цвет - группа по деньгам. Лучи из начала координат - форматы с разным средним чеком.</span>
      </figcaption>
      <div id="chart-size" class="chart chart-tall" role="img" aria-label="Диаграмма рассеяния выручки и числа чеков точек"></div>
    </figure>

    <details class="card more">
      <summary><strong>Подробнее: как выбирается число групп</strong></summary>
      <p>
        Алгоритм склеивает точки снизу вверх: сначала каждая аптека - отдельная группа, затем на каждом шаге объединяются две самые похожие группы, пока не останется одна. У каждого склеивания есть «цена» - насколько выросла разнородность внутри групп. Пока объединяются похожие точки, цена маленькая; когда приходится склеивать действительно разные группы, она резко подскакивает. Останавливаемся перед скачком - это «локоть». Для проверки используется второй критерий - коэффициент силуэта: насколько каждая точка ближе к своей группе, чем к соседней (выше - чётче разделение). Число групп ищется в разумном для бизнеса диапазоне: деление сети всего на две группы для решений бесполезно.
      </p>
      <p>
        {kAgree.length > 0 && <>По {listRu(kAgree)} оба критерия указывают на одно и то же число. </>}{kDiffer.length > 0 && <>По {listRu(kDiffer.map((x) => `${x.name} (локоть - ${x.chosen}, силуэт - ${x.best})`))} силуэт предпочитает меньше групп: он награждает крупные, хорошо разделённые группы, а локоть ловит и более тонкие различия. </>}Итоговый выбор проверяется деньгами: матрицами по сегментам на неделях, которых расчёт не видел.
      </p>
      <div class="seg" id="k-switch" role="group" aria-label="Кластеризация">
        {Object.keys(data.k_selection).sort((a, b) => kOrder.indexOf(a) - kOrder.indexOf(b)).map((name) => (
          <button type="button" data-k={name} class={name === 'Выручка и чеки' ? 'on' : ''}>{kLabel[name]}</button>
        ))}
      </div>
      <div id="chart-k" class="chart chart-tall" role="img" aria-label="Цена склеивания и коэффициент силуэта по числу групп"></div>
      <p class="muted note" id="k-note"></p>
    </details>

    <h2>3. Цена: дорогой или дешёвый товар выбирают покупатели</h2>
    <p>
      Сначала каждый товар получает ценовой уровень внутри своей группы сравнения: 30% самых дешёвых пачек - «дешёвые», 30% самых дорогих - «дорогие», остальные - «средние». Покупатель платит за пачку, поэтому сравнивается цена пачки, но только с пачками похожего объёма из той же подкатегории: иначе упаковка на 100 таблеток всегда казалась бы «дорогой», а на 10 - «дешёвой». Сиропы, мази и нелекарственный ассортимент сравниваются по цене упаковки внутри подкатегории.
    </p>
    <p>
      Затем аптека описывается долями своей выручки в дешёвом, среднем и дорогом товаре, и аптеки с похожими долями объединяются в ценовые группы.
    </p>
    <figure class="card chart-card">
      <figcaption>
        <strong>Ценовые группы аптек</strong>
        <span class="muted">Каждая строка - группа аптек, а не товаров: аптеки в ней похожи тем, какую долю выручки делают на дешёвом, среднем и дорогом товаре. Группы идут от самой экономичной к самой премиальной.</span>
      </figcaption>
      <div id="chart-price" class="chart" role="img" aria-label="Столбчатая диаграмма ценовых групп аптек"></div>
    </figure>

    <h2>4. Ассортимент: на что «заточена» точка</h2>
    <p>
      Точка описывается долями категорий в своей выручке, независимо от размера. Индекс категории в группе показывает, во сколько раз её доля выше или ниже средней по сети. По нему группа и получает название: категории с индексом от 1,3 - это её «уклон».
    </p>
    <figure class="card chart-card">
      <figcaption>
        <strong>Индекс категорий в ассортиментных группах</strong>
        <span class="muted">1,0 - как в среднем по сети. Красный - категория продаётся заметно больше среднего, синий - меньше. В скобках - число аптек.</span>
      </figcaption>
      <div id="chart-assort" class="chart chart-tall" role="img" aria-label="Тепловая карта индексов категорий по ассортиментным группам"></div>
    </figure>

    <h2>5. Итоговые сегменты</h2>
    <p>
      Каждая аптека получает три метки - группу по размеру, по ассортименту и по цене. Группы переводятся в понятные слова: размер - по шкале от «малых» до «крупных», ассортимент - в уклон («сердце и кровь», «мать и дитя, косметика» или «универсальный»), цена - от «эконома» до «премиума». Сегмент - сочетание трёх слов, например «{ex.segment}». Сочетания, в которые попало меньше 5 аптек, вливаются в самый похожий крупный сегмент. В исходном расчёте этот шаг делали вручную в Excel, здесь он полностью автоматический.
    </p>
    <figure class="card chart-card">
      <figcaption>
        <strong>Схема сборки сегмента</strong>
        <span class="muted">Коды групп (В, А, Ц) и точки ({ex.code}) условные, в скобках - число аптек. Выделен путь одной аптеки.</span>
      </figcaption>
      <div class="scheme">
        <div class="scheme-col">
          <div class="scheme-head"><strong>Размер</strong><span>группы по выручке и чекам</span></div>
          {data.size_clusters.map((c) => (
            <div class={c.cluster === ex.size_cluster ? 'scheme-item hit' : 'scheme-item'}><span>{c.cluster} ({c.n})</span><span>→ {c.level}</span></div>
          ))}
          <div class="scheme-rule">по средней выручке: шкала от «малых» до «крупных»</div>
        </div>
        <div class="scheme-col">
          <div class="scheme-head"><strong>Ассортимент</strong><span>группы по долям категорий</span></div>
          {data.assort.clusters.map((c, i) => (
            <div class={c === ex.assort_cluster ? 'scheme-item hit' : 'scheme-item'}><span>{c} ({data.assort.n[i]})</span><span>→ {data.assort.profiles[i]}</span></div>
          ))}
          <div class="scheme-rule">категории с индексом от 1,3, не больше двух</div>
        </div>
        <div class="scheme-col">
          <div class="scheme-head"><strong>Цена</strong><span>группы по долям дешёвого и дорогого</span></div>
          {data.price_clusters.map((c) => (
            <div class={c.cluster === ex.price_cluster ? 'scheme-item hit' : 'scheme-item'}><span>{c.cluster} ({c.n})</span><span>→ {c.level}</span></div>
          ))}
          <div class="scheme-rule">крайние - «эконом» и «премиум», между ними «медиум -» и «медиум +»</div>
        </div>
      </div>
      <div class="scheme-arrow" aria-hidden="true">↓</div>
      <div class="scheme-result">
        <strong>Сегмент = размер · уклон · цена</strong>
        <span>{ex.code}: {ex.size_cluster} + {ex.assort_cluster} + {ex.price_cluster} = «{ex.segment}»</span>
        <span class="muted">Сочетания меньше 5 аптек вливаются в самый похожий сегмент.</span>
      </div>
    </figure>
    <div class="card table-card">
      <table class="data">
        <thead>
          <tr><th>Сегмент</th><th class="num">Аптек</th><th class="num">Площадь, м²</th><th class="num">Выручка, млн ₽</th><th class="num">Средний чек, ₽</th><th class="num">Доля дорогого</th></tr>
        </thead>
        <tbody>
          {segments.map((s) => (
            <tr>
              <td>{s.segment}</td>
              <td class="num">{s.n}</td>
              <td class="num">{s.square}</td>
              <td class="num">{num(s.revenue / 1e6, 1)}</td>
              <td class="num">{int(s.cheque)}</td>
              <td class="num">{pct(s.high)}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="muted note">Медианы по аптекам сегмента за 4 недели; доля дорогого - средняя доля выручки в дорогом товаре подкатегории.</p>
      <details>
        <summary>Какие маленькие сочетания влились в крупные сегменты ({data.merges.length})</summary>
        <table class="data">
          <thead><tr><th>Сочетание</th><th class="num">Аптек</th><th>Влилось в сегмент</th></tr></thead>
          <tbody>
            {data.merges.map((m) => <tr><td>{m.from}</td><td class="num">{m.n}</td><td>{m.to}</td></tr>)}
          </tbody>
        </table>
      </details>
    </div>
    <p>
      Сегменты читаются как управленческие решения. Премиальный сегмент ({points(premiumN)}) с уклоном в косметику и БАД - кандидат на расширенный ассортимент лечебной косметики. Эконом-аптеки ({points(economyN)}) с уклоном в препараты для сердца и крови - на широкий выбор недорогих дженериков. Конкретный список товаров для полки каждого сегмента - ассортиментная матрица - строится в <a href="/projects/assortment-matrix/">следующем проекте</a>.
    </p>

    <h2>6. Проверка: нашёл ли алгоритм заложенную структуру</h2>
    <p>
      Такая проверка возможна только на синтетике. Генератор данных заранее назначил каждой аптеке скрытый тип - архетип (центральная, у дома, дискаунтер, премиум, в ТЦ, сельская, при поликлинике), а алгоритм его не видел. Совпадение сегментов с архетипами меряется скорректированным индексом Рэнда: доля совпадения с поправкой на случайность, где 0 - как у случайного разбиения, 1 - полное совпадение.
    </p>
    <div class="pair">
      <div class="card stat"><span class="stat-label">Итоговые сегменты</span><span class="stat-value">{num(quality.segment)}</span></div>
      <div class="card stat"><span class="stat-label">Только ассортимент</span><span class="stat-value">{num(quality.assort)}</span></div>
      <div class="card stat"><span class="stat-label">Только цена</span><span class="stat-value">{num(quality.price)}</span></div>
      <div class="card stat"><span class="stat-label">Только размер</span><span class="stat-value">{num(quality.size)}</span></div>
    </div>
    <p>
      Ни один срез по отдельности не восстанавливает архетипы, вместе они дают {num(quality.segment)}. {whole.length > 0 && <>Целиком в одном сегменте оказались {listRu(whole)}. </>}{split.length > 0 && <>Остальные архетипы алгоритм дробит по размеру и цене: {listRu(split)} сегмента - для управления ассортиментом это скорее плюс.</>}
    </p>
    <figure class="card chart-card">
      <figcaption>
        <strong>Из каких архетипов состоит каждый сегмент</strong>
        <span class="muted">Число аптек в каждой паре «сегмент × архетип». Если строка сегмента почти целиком в одном столбце, сегмент совпал с архетипом.</span>
      </figcaption>
      <div id="chart-arch" class="chart chart-tall" role="img" aria-label="Тепловая карта соответствия сегментов и архетипов"></div>
    </figure>
    <p class="muted">
      Совпадение подтверждает, что метод работает и находит заложенную структуру. Но архетипы придуманы для синтетики, поэтому реальную пользу показывает другая проверка - деньгами: <a href="/projects/assortment-matrix/">матрицы по сегментам</a> на неделях, которых расчёт не видел.
    </p>

    <p class="actions">
      <a class="btn primary" href="/projects/assortment-matrix/">Дальше: матрица под сегмент</a>
      <a class="btn" href={codeUrl}>Ноутбук на GitHub</a>
      <a class="btn" href={synthUrl}>Генератор данных</a>
    </p>
  </article>
</Base>

<script>
  import data from '../../data/store-clustering.json';
  import { mountCharts, int, pct } from '../../scripts/charts';

  const SHORT: Record<string, string> = {
    'БАД и витамины': 'БАД',
    'Гигиена и косметика': 'Косметика',
    'Дыхательная система': 'Простуда',
    'Костно-мышечная система': 'Опорно-двиг.',
    'Мать и дитя': 'Мать и дитя',
    'Медицинские изделия': 'Медизделия',
    'Мочеполовая система и половые гормоны': 'Урол. и гинек.',
    'Нервная система': 'Нервная сист.',
    'Пищеварение и обмен веществ': 'ЖКТ',
    'Противомикробные': 'Антибиотики',
    'Прочие препараты': 'Прочие',
    'Сердце и кровь': 'Сердце и кровь',
  };

  mountCharts((init, { C, base, axis }) => {
    const narrow = window.innerWidth < 560;

    // размер: выручка × чеки, цвет - уровень размера
    const levels = ['Малые', 'Средние', 'Крупные'];
    const stores = data.stores as [number, number, number, string, string, number, number, string][];
    init('chart-size').setOption({
      ...base,
      legend: { top: 0, textStyle: { color: C.muted }, itemWidth: 10, itemHeight: 10 },
      grid: { left: 64, right: 16, top: 40, bottom: 48 },
      tooltip: {
        ...base.tooltip,
        formatter: (p: any) =>
          `<b>${p.data[7]}</b><br/>Выручка: ${int(p.data[0] / 1000)} тыс. ₽<br/>Чеков: ${int(p.data[1])}<br/>Площадь: ${p.data[2]} м²`,
      },
      xAxis: { ...axis, type: 'value', min: 0, name: 'выручка за 4 недели, млн ₽', nameLocation: 'middle', nameGap: 30,
        axisLabel: { color: C.muted, formatter: (x: number) => String(x / 1e6).replace('.', ',') } },
      yAxis: { ...axis, type: 'value', min: 0, name: 'чеков', nameLocation: 'middle', nameGap: 44,
        axisLabel: { color: C.muted, formatter: (x: number) => int(x) } },
      series: levels.map((lv, i) => ({
        name: lv,
        type: 'scatter',
        symbolSize: 8,
        data: stores.filter((s) => s[7].startsWith(lv)),
        itemStyle: { color: C.series[[0, 2, 1][i]], opacity: 0.85, borderColor: C.surface, borderWidth: 1 },
      })),
    });

    // выбор числа кластеров: цена склеивания (столбцы) и силуэт (линия), переключатель кластеризаций
    const K = data.k_selection as Record<string, { k: number[]; cost: number[]; silhouette: number[]; chosen: number; k_min: number; k_max: number }>;
    const kChart = init('chart-k');
    const drawK = (name: string) => {
      const d = K[name];
      const cats = d.k.map(String);
      const iChosen = d.k.indexOf(d.chosen);
      const iBest = d.silhouette.indexOf(Math.max(...d.silhouette));
      const f2 = (x: number) => x.toFixed(2).replace('.', ',');
      kChart.setOption({
        ...base,
        tooltip: { ...base.tooltip, trigger: 'axis', axisPointer: { type: 'shadow' },
          formatter: (ps: any) => `<b>k = ${ps[0].axisValue}</b><br/>` + ps.map((p: any) =>
            `${p.seriesName}: ${f2(p.value)}`).join('<br/>') },
        axisPointer: { link: [{ xAxisIndex: 'all' }] },
        grid: [{ left: 48, right: 16, top: 28, height: '38%' }, { left: 48, right: 16, top: '62%', bottom: 36 }],
        xAxis: [0, 1].map((i) => ({ ...axis, type: 'category', gridIndex: i, data: cats, splitLine: { show: false },
          name: i === 1 ? 'число кластеров k' : '', nameLocation: 'middle', nameGap: 26, axisLabel: { color: C.muted, show: i === 1 } })),
        yAxis: [
          { ...axis, type: 'value', gridIndex: 0, name: 'цена склеивания', nameTextStyle: { color: C.muted, align: 'left' } },
          { ...axis, type: 'value', gridIndex: 1, name: 'силуэт', scale: true, nameTextStyle: { color: C.muted, align: 'left' },
            axisLabel: { color: C.muted, formatter: (x: number) => f2(x) } },
        ],
        series: [
          { name: 'цена шага k → k-1', type: 'bar', xAxisIndex: 0, yAxisIndex: 0, barMaxWidth: 30,
            data: d.cost.map((v, i) => ({ value: v, itemStyle: { color: i === iChosen ? C.accent : C.series[5], borderRadius: [4, 4, 0, 0] } })),
            markArea: { silent: true, itemStyle: { color: C.accent, opacity: 0.07 },
              data: [[{ xAxis: String(d.k_min) }, { xAxis: String(d.k_max) }]] } },
          { name: 'силуэт', type: 'line', xAxisIndex: 1, yAxisIndex: 1, data: d.silhouette, symbolSize: 7,
            lineStyle: { color: C.series[0], width: 2 },
            itemStyle: { color: C.series[0] },
            markLine: { silent: true, symbol: 'none', lineStyle: { color: C.accent, type: 'dashed' },
              label: { color: C.muted, formatter: `выбрано k = ${d.chosen}` }, data: [{ xAxis: String(d.chosen) }] } },
        ],
      }, true);
      const same = iBest === iChosen;
      document.getElementById('k-note')!.textContent = same
        ? `Локоть и силуэт согласны: k = ${d.chosen}, силуэт ${f2(d.silhouette[iChosen])} - максимальный.`
        : `Локоть выбрал k = ${d.chosen} (силуэт ${f2(d.silhouette[iChosen])}), максимум силуэта при k = ${d.k[iBest]} (${f2(d.silhouette[iBest])}) - разница небольшая.`;
    };
    const current = () => (document.querySelector('#k-switch button.on') as HTMLElement)?.dataset.k ?? 'Выручка и чеки';
    drawK(current());
    document.querySelectorAll<HTMLButtonElement>('#k-switch button').forEach((b) => {
      b.onclick = () => {
        document.querySelectorAll('#k-switch button').forEach((x) => x.classList.toggle('on', x === b));
        drawK(b.dataset.k!);
      };
    });

    // цена: профиль ценовых кластеров
    const pc = data.price_clusters;
    // подписи групп: уровень и число аптек; если медиум-групп несколько, уточняем, к какому краю ближе
    const plural = (n: number) =>
      n % 10 === 1 && n % 100 !== 11 ? 'аптека' : [2, 3, 4].includes(n % 10) && ![12, 13, 14].includes(n % 100) ? 'аптеки' : 'аптек';
    const priceLabel = (level: string, _i: number, n: number) => `${level[0].toUpperCase() + level.slice(1)} · ${n} ${plural(n)}`;
    const tiers = [
      { key: 'low', name: 'дешёвый', color: C.series[0] },
      { key: 'medium', name: 'средний', color: C.series[5] },
      { key: 'high', name: 'дорогой', color: C.series[1] },
    ];
    init('chart-price').setOption({
      ...base,
      legend: { top: 0, textStyle: { color: C.muted }, itemWidth: 10, itemHeight: 10 },
      grid: { left: narrow ? 150 : 240, right: 16, top: 36, bottom: 28 },
      tooltip: { ...base.tooltip, trigger: 'axis', axisPointer: { type: 'shadow' },
        valueFormatter: (x: number) => pct(x) },
      xAxis: { ...axis, type: 'value', max: 1, axisLabel: { color: C.muted, formatter: (x: number) => pct(x) } },
      yAxis: { ...axis, type: 'category', inverse: true, splitLine: { show: false },
        data: pc.map((p, i) => priceLabel(p.level, i, p.n)) },
      series: tiers.map((t) => ({
        name: t.name, type: 'bar', stack: 'p', barWidth: '60%',
        data: pc.map((p) => (p as any)[t.key]),
        itemStyle: { color: t.color },
        label: { show: true, color: '#fff', formatter: (p: any) => (p.value >= 0.08 ? pct(p.value) : '') },
      })),
    });

    // ассортимент: тепловая карта индексов
    const A = data.assort;
    const cells: [number, number, number][] = [];
    A.index.forEach((row, y) => row.forEach((v, x) => cells.push([x, y, v as number])));
    init('chart-assort').setOption({
      ...base,
      grid: { left: narrow ? 64 : 250, right: 8, top: 8, bottom: narrow ? 100 : 84 },
      tooltip: { ...base.tooltip, formatter: (p: any) =>
        `<b>${A.clusters[p.data[1]]} · ${A.profiles[p.data[1]]}</b><br/>${A.categories[p.data[0]]}: ${String(p.data[2]).replace('.', ',')}` },
      xAxis: { ...axis, type: 'category', data: A.categories.map((c) => SHORT[c] ?? c), splitLine: { show: false },
        axisLabel: { color: C.muted, rotate: 45, interval: 0, fontSize: narrow ? 10 : 12 } },
      yAxis: { ...axis, type: 'category', inverse: true, splitLine: { show: false },
        data: A.clusters.map((c, i) => (narrow ? `${c} (${A.n[i]})` : `${c} (${A.n[i]}) · ${A.profiles[i]}`)),
        axisLabel: { color: C.text, width: 240, overflow: 'truncate', fontSize: narrow ? 10 : 12 } },
      visualMap: { show: false, min: 0.3, max: 2.2, inRange: { color: [C.low, C.surface2, C.high] } },
      series: [{
        type: 'heatmap', data: cells,
        label: { show: !narrow, color: C.text, fontSize: 11, formatter: (p: any) => Number(p.value[2]).toFixed(1).replace('.', ',') },
        itemStyle: { borderColor: C.surface, borderWidth: 2 },
      }],
    });

    // проверка: сегменты × архетипы
    const R = data.archetypes;
    const ac: [number, number, number][] = [];
    R.counts.forEach((row, y) => row.forEach((v, x) => v > 0 && ac.push([x, y, v])));
    init('chart-arch').setOption({
      ...base,
      grid: { left: narrow ? 150 : 270, right: 12, top: 8, bottom: narrow ? 104 : 90 },
      tooltip: { ...base.tooltip, formatter: (p: any) => `<b>${R.segments[p.data[1]]}</b><br/>${R.archetypes[p.data[0]]}: ${p.data[2]}` },
      xAxis: { ...axis, type: 'category', data: R.archetypes, splitLine: { show: false },
        axisLabel: { color: C.muted, rotate: 45, interval: 0, fontSize: narrow ? 10 : 12 } },
      yAxis: { ...axis, type: 'category', inverse: true, data: R.segments, splitLine: { show: false },
        axisLabel: { color: C.text, width: narrow ? 140 : 260, overflow: 'truncate', fontSize: narrow ? 10 : 12 } },
      visualMap: { show: false, min: 0, max: Math.max(...R.counts.flat()), inRange: { color: [C.surface2, C.accent] } },
      series: [{ type: 'heatmap', data: ac, label: { show: true, color: C.text, fontSize: 11 },
        itemStyle: { borderColor: C.surface, borderWidth: 2 } }],
    });
  });
</script>
