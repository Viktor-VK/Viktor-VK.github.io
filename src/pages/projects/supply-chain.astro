</style>

<script>
  // тепловая карта: раскрытие склада до магазинов
  document.querySelectorAll<HTMLButtonElement>('.heat .wh button').forEach((b) => {
    b.addEventListener('click', () => {
      const open = b.getAttribute('aria-expanded') !== 'true';
      b.setAttribute('aria-expanded', String(open));
      document.querySelectorAll<HTMLTableRowElement>(`.heat tr[data-parent="${b.dataset.wh}"]`).forEach((r) => (r.hidden = !open));
    });
  });
</script>

<script>
  import data from '../../data/supply-chain.json';
  import { mountCharts, int, mln, pct } from '../../scripts/charts';

  mountCharts((init, { C, base, axis }) => {
    const narrow = window.innerWidth < 560;
    const dm = (s: string) => s.slice(8, 10) + '.' + s.slice(5, 7);
    const stageColor: Record<string, string> = { 'Распределение': C.series[0], 'Закуп': C.series[1], 'Поставщик': C.muted };
    const money = (x: number) => mln(x) + ' млн ₽';

    // потери по причинам: цвет - этап, тёмная часть - весь день без товара, светлая - закончился за день
    const K = data.causes;
    init('chart-causes').setOption({
      ...base,
      legend: { top: 0, textStyle: { color: C.muted }, itemWidth: 12, itemHeight: 10 },
      grid: { left: narrow ? 140 : 180, right: 56, top: 32, bottom: 24 },
      tooltip: { ...base.tooltip, trigger: 'axis', axisPointer: { type: 'shadow' }, valueFormatter: money },
      xAxis: { ...axis, type: 'value', axisLabel: { color: C.muted, formatter: (x: number) => mln(x, 0) } },
      yAxis: { ...axis, type: 'category', inverse: true, data: K.map((c) => c.outcome), splitLine: { show: false },
        axisLabel: { color: C.text, fontSize: narrow ? 11 : 12 } },
      series: [
        { name: 'весь день без товара', type: 'bar', stack: 'k', itemStyle: { color: C.text },
          data: K.map((c) => ({ value: c.empty, itemStyle: { color: stageColor[c.stage] } })) },
        { name: 'закончился за день', type: 'bar', stack: 'k', itemStyle: { color: C.muted, opacity: 0.45 },
          data: K.map((c) => ({ value: c.soldout, itemStyle: { color: stageColor[c.stage], opacity: 0.45 } })),
          label: { show: true, position: 'right', color: C.muted, formatter: (p: any) => mln(K[p.dataIndex].empty + K[p.dataIndex].soldout, 0) } },
      ],
    });

    // по неделям, сложено по этапам
    const Wk = data.weekly as Record<string, any>;
    const stages = ['Распределение', 'Закуп', 'Поставщик'];
    init('chart-weekly').setOption({
      ...base,
      legend: { top: 0, textStyle: { color: C.muted }, itemWidth: 12, itemHeight: 10 },
      grid: { left: 44, right: 12, top: 36, bottom: 28 },
      tooltip: { ...base.tooltip, trigger: 'axis', axisPointer: { type: 'shadow' }, valueFormatter: money },
      xAxis: { ...axis, type: 'category', data: Wk.weeks.map(dm), splitLine: { show: false }, axisLabel: { color: C.muted } },
      yAxis: { ...axis, type: 'value', axisLabel: { color: C.muted, formatter: (x: number) => mln(x, 0) } },
      series: stages.map((st) => ({ name: st, type: 'bar', stack: 'w', data: Wk[st], itemStyle: { color: stageColor[st] } })),
    });

    // фактические запасы: доля дней дефицита по группам запаса, магазины и склады
    const Cv = data.cover as Record<string, { group: string; deficit: number; share: number }[]>;
    const lvls: [string, string][] = [['Магазин', 'магазины'], ['Склад', 'склады']];
    init('chart-cover').setOption({
      ...base,
      grid: narrow
        ? [{ left: 44, right: 8, top: 28, height: '30%' }, { left: 44, right: 8, top: '62%', bottom: 40 }]
        : [{ left: 44, right: '54%', top: 30, bottom: 48 }, { left: '54%', right: 8, top: 30, bottom: 48 }],
      tooltip: { ...base.tooltip, trigger: 'axis', axisPointer: { type: 'shadow' } },
      xAxis: lvls.map(([k], i) => ({ ...axis, type: 'category', gridIndex: i, splitLine: { show: false },
        data: Cv[k].map((c) => c.group), axisLabel: { color: C.muted, fontSize: 10, interval: 0,
          formatter: (v: string, j: number) => `${v}\n${pct(Cv[k][j].share)} пар` } })),
      yAxis: lvls.map(([, t], i) => ({ ...axis, type: 'value', gridIndex: i, name: t, nameTextStyle: { color: C.muted, align: 'left' },
        axisLabel: { color: C.muted, formatter: (x: number) => pct(x) } })),
      series: lvls.map(([k], i) => ({ name: 'доля дней дефицита', type: 'bar', xAxisIndex: i, yAxisIndex: i, barMaxWidth: 36,
        data: Cv[k].map((c) => c.deficit), itemStyle: { color: C.series[i] },
        label: { show: true, position: 'top', color: C.muted, formatter: (p: any) => pct(p.value) } })),
    });

    // сквозная картина по товару: три панели с общей осью дат
    const E = data.example as any;
    const whs = Object.keys(E.warehouses);
    const orderDates: string[] = E.orders.map((o: any) => o[0]);
    const byDate = (i: number) => E.dates.map((d: string) => { const k = orderDates.indexOf(d); return k < 0 ? null : E.orders[k][i]; });
    const whColor = [C.series[0], C.series[1], C.series[3]];
    const top = narrow ? 64 : 40;
    init('chart-chain').setOption({
      ...base,
      legend: [
        { top: 0, left: 0, data: ['заказано', 'подтвердил поставщик'], textStyle: { color: C.muted }, itemWidth: 12, itemHeight: 10 },
        { top: narrow ? 22 : 0, right: 0, data: whs, textStyle: { color: C.muted }, itemWidth: 12, itemHeight: 4 },
      ],
      tooltip: { ...base.tooltip, trigger: 'axis' },
      axisPointer: { link: [{ xAxisIndex: 'all' }] },
      grid: [
        { left: 48, right: 12, top: top + 24, height: '18%' },
        { left: 48, right: 12, top: '42%', height: '22%' },
        { left: 48, right: 12, top: '74%', bottom: 28 },
      ],
      xAxis: [0, 1, 2].map((i) => ({ ...axis, type: 'category', gridIndex: i, data: E.dates.map(dm), splitLine: { show: false },
        axisLabel: { color: C.muted, show: i === 2, interval: 13 } })),
      yAxis: ['закуп у поставщика, шт.', 'остаток склада, шт.', 'магазинов в дефиците'].map((name, i) => ({
        ...axis, type: 'value', gridIndex: i, minInterval: 1, name, nameTextStyle: { color: C.muted, align: 'left' },
        axisLabel: { color: C.muted, formatter: (x: number) => int(x) } })),
      series: [
        { name: 'заказано', type: 'bar', xAxisIndex: 0, yAxisIndex: 0, data: byDate(1), barWidth: 5, itemStyle: { color: C.muted } },
        { name: 'подтвердил поставщик', type: 'bar', xAxisIndex: 0, yAxisIndex: 0, data: byDate(2), barWidth: 5, itemStyle: { color: C.accent } },
        ...whs.flatMap((w, i) => [
          { name: w, type: 'line', xAxisIndex: 1, yAxisIndex: 1, showSymbol: false, data: E.warehouses[w].stock,
            lineStyle: { color: whColor[i], width: 2 }, itemStyle: { color: whColor[i] } },
          { name: w, type: 'line', xAxisIndex: 2, yAxisIndex: 2, showSymbol: false, step: 'middle', data: E.warehouses[w].deficit,
            lineStyle: { color: whColor[i], width: 2 }, itemStyle: { color: whColor[i] } },
        ]),
      ],
    });
  });
</script>
