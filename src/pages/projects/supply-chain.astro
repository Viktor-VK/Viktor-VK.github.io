---
import Base from '../../layouts/Base.astro';
import data from '../../data/supply-chain.json';
import '../../styles/project.css';

const codeUrl = 'https://github.com/Viktor-VK/portfolio/tree/master/' + encodeURIComponent('Сквозной анализ цепи поставок');
const { meta, causes } = data;

const num = (x: number, d = 1) => x.toFixed(d).replace('.', ',');
const mln = (x: number, d = 0) => num(x / 1e6, d);
const pct = (x: number, d = 0) => num(x * 100, d) + '%';
const int = (x: number) => Math.round(x).toLocaleString('ru-RU');

const total = causes.reduce((s, c) => s + c.empty + c.soldout, 0);
const byOutcome = Object.fromEntries(causes.map((c) => [c.outcome, c.empty + c.soldout]));
const internal = total - (byOutcome['дефицит у поставщика'] ?? 0);
// фактические запасы: группы пар по среднему запасу в днях продаж
const sc = data.cover['Магазин'];
const wc = data.cover['Склад'];
const scLast = sc[sc.length - 1];
const storeFlat = sc[1].deficit - scLast.deficit < 0.03;       // выше 3-5 дней дефицит почти не падает
const whSteep = wc[0].deficit > 3 * wc[1].deficit;             // склады с малым запасом пустеют заметно чаще
// тепловая карта: дни дефицита «магазин - товар - день» по неделям; яркость - от максимума своего уровня
const H = data.heatmap;
const whMax = Math.max(...H.warehouses.flatMap((w) => w.values));
const stMax = Math.max(...H.warehouses.flatMap((w) => w.stores.flatMap((m) => m.values)));
const heat = (v: number, max: number) => `background: color-mix(in srgb, var(--scale-bad) ${Math.round((v / max) * 80)}%, transparent)`;
const firstWeekDays = 7 - ((new Date(meta.period_from).getDay() + 6) % 7);
// старт продаж новинок
const L = data.launch;
const lCause = Object.fromEntries(L.causes.map((c) => [c.outcome, c.lost]));
const lDist = (lCause['ошибка распределения'] ?? 0) + (lCause['перекос распределения'] ?? 0);
const lSup = lCause['дефицит у поставщика'] ?? 0;
// выводы: доли итогов разбора в общих потерях
const share = (...keys: string[]) => keys.reduce((a, k) => a + (byOutcome[k] ?? 0), 0) / total;
const distShare = share('ошибка распределения', 'перекос распределения');
const buyShare = share('ошибка закупа', 'перекос закупа');
const supShare = share('дефицит у поставщика');
const buySkewLost = byOutcome['перекос закупа'] ?? 0;
const fmtDate = (s: string) => new Date(s).toLocaleDateString('ru-RU', { day: 'numeric', month: 'long' });

// шаги разбора: вопрос, итог при ответе «да», этап
const steps = [
  { q: 'Остатка склада накануне вечером хватало, чтобы довезти товар этому магазину?', outcome: 'ошибка распределения', note: 'склад не довёз товар', stage: 'dist' },
  { q: 'В других магазинах этого склада товар лежит с запасом больше недели продаж?', outcome: 'перекос распределения', note: 'склад развёз товар неравномерно', stage: 'dist' },
  { q: 'Поставщик привёз весь последний заказ (или заказа не было)?', outcome: 'ошибка закупа', note: 'заказали недостаточно', stage: 'buy' },
  { q: 'В других регионах товар лежит с запасом больше двух недель продаж?', outcome: 'перекос закупа', note: 'дефицитный товар неравномерно распределён между складами', stage: 'buy' },
];
---

<Base
  title="Сквозной анализ цепи поставок"
  description="Движение товара от поставщика через склады до магазинов по дням и причина каждого дня дефицита: поставщик, закуп или распределение."
>
  <article class="project-page">
    <p class="muted crumbs"><a href="/#projects">Проекты</a> / сквозной анализ цепи поставок</p>
    <span class="eyebrow">Проект в работе · Python, SQL, DuckDB, симуляция</span>
    <h1>Сквозной анализ цепи поставок</h1>
    <p class="lead">
      Когда товара нет на полке магазина, важно понять, где в цепочке «поставщик - склад - магазин» возникла проблема: от этого зависит, кто и что должен исправить. Расчёт восстанавливает движение товара по дням на всех этапах и для каждого дня дефицита в магазине называет причину.
    </p>

    <div class="card notice">
      <p>
        <strong>Данные синтетические.</strong> Это симуляция сети магазинов электроники: {meta.skus} моделей смартфонов Apple, поставщик, {meta.warehouses} склада и {meta.stores} магазинов, {fmtDate(meta.period_from)} - {fmtDate(meta.period_to)} 2025 года, включая выход iPhone 17. Разбор использует только то, что есть в учётной системе: заказы поставщику, журнал движений и текущий остаток. В симуляцию специально заложены проблемы на каждом этапе, чтобы проверить, что разбор их находит. Названия моделей реальные, цены и объёмы условные.
      </p>
    </div>

    <section class="card summary">
      <span class="eyebrow">Коротко</span>
      <ul>
        <li><strong>Задача.</strong> Дефицит в магазине может возникнуть на любом этапе: поставщик недопоставил, закупщик заказал мало, склад не довёз. Без разбора непонятно, кому и что исправлять.</li>
        <li><strong>Что сделано.</strong> Восстановлены остатки каждого склада и магазина на каждый день, а для каждого дня дефицита причина определяется по пяти простым правилам - от магазина вверх по цепочке.</li>
        <li><strong>Результат.</strong> Дефицит стоил сети около {mln(meta.lost_est)} млн ₽ - {pct(meta.lost_est / meta.sales, 1)} продаж. {pct(internal / total)} этих потерь - ошибки внутри сети, в закупе и распределении, которые можно исправить; остальное - нехватка товара у поставщика.</li>
      </ul>
    </section>

    <h2>1. Как движется товар</h2>
    <div class="flowline" aria-label="Схема движения товара">
      <div class="node"><strong>Поставщик</strong><span class="muted">подтверждает заказ целиком или частично</span></div>
      <div class="link"><span aria-hidden="true">→</span><span class="muted">закуп раз в неделю, доставка 2 дня</span></div>
      <div class="node"><strong>{meta.warehouses} склада</strong><span class="muted">каждый обслуживает свой регион</span></div>
      <div class="link"><span aria-hidden="true">→</span><span class="muted">пополнение каждый день, доставка 1 день</span></div>
      <div class="node"><strong>{meta.stores} магазинов</strong><span class="muted">продают покупателям</span></div>
    </div>
    <p>
      Учётная система хранит только текущий остаток и журнал движений. Остаток на каждый прошлый день восстанавливается «откатом» назад: из сегодняшнего остатка вычитаются все движения после нужного дня - этот метод подробно разобран в проекте <a href="/projects/stock-history/">«Восстановление истории остатков»</a>. Так получена полная история по каждому складу и магазину - она совпала с истинной из симуляции в {pct(meta.match_share)} случаев.
    </p>
    <p>
      Дефицит в магазине бывает двух видов: <strong>весь день без товара</strong> ({int(meta.days_empty)} «магазино-дней» за период) и <strong>товар закончился за день</strong> ({int(meta.days_soldout)}). Во втором случае часть покупателей приходит, когда товара уже нет.
    </p>
    <figure class="card chart-card">
      <figcaption>
        <strong>Дни дефицита в магазинах по неделям</strong>
        <span class="muted">Число «магазино-товаро-дней» за неделю, когда товара не было весь день или он закончился: один товар без остатка 6 дней - это 6. Строка склада - сумма по его магазинам; нажмите на склад, чтобы раскрыть магазины. Первая неделя неполная ({firstWeekDays} дня).</span>
      </figcaption>
      <div class="heat-wrap">
        <table class="heat">
          <thead>
            <tr><th>Склад / магазин</th>{H.weeks.map((w) => <th>{w}</th>)}</tr>
          </thead>
          <tbody>
            {H.warehouses.map((w, i) => (
              <>
                <tr class="wh">
                  <th><button type="button" aria-expanded="false" data-wh={i}><span class="caret" aria-hidden="true">▸</span>{w.name} <span class="muted">({w.stores.length} маг.)</span></button></th>
                  {w.values.map((v) => <td style={heat(v, whMax)}>{v}</td>)}
                </tr>
                {w.stores.map((m) => (
                  <tr class="store" data-parent={i} hidden>
                    <th>{m.name.replace('Магазин ', '')}</th>
                    {m.values.map((v) => <td style={heat(v, stMax)}>{v || ''}</td>)}
                  </tr>
                ))}
              </>
            ))}
          </tbody>
        </table>
      </div>
    </figure>

    <h2>2. Как определяется причина</h2>
    <p>
      Для каждого дня дефицита разбор идёт по цепочке вверх и останавливается на первом ответе «да». Статус модели - новинка или выводимая - не важен: если товар продаётся, его нужно закупать.
    </p>
    <div class="card decision">
      <div class="start">Дефицит в магазине</div>
      {steps.map((s, i) => (
        <>
          <div class="step">
            <div class="q"><span class="n">{i + 1}</span>{s.q}</div>
            <div class={`out ${s.stage}`}><span class="yes">да</span><strong>{s.outcome}</strong><span class="muted">{s.note}</span></div>
          </div>
          <div class="no" aria-hidden="true">нет ↓</div>
        </>
      ))}
      <div class="out sup last"><strong>дефицит у поставщика</strong><span class="muted">товара не хватило на всех - это не ошибка сети</span></div>
    </div>

    <h2>3. Где теряются деньги</h2>
    <p>
      Потери дня без товара - все ожидаемые продажи этого дня. Если товар закончился за день, учёт не видит покупателей, пришедших позже; их число оценивается по среднему спросу и утреннему остатку - покупатели приходят случайно, и эту случайность можно посчитать.
    </p>
    <figure class="card chart-card">
      <figcaption>
        <strong>Упущенные продажи по причинам, млн ₽</strong>
        <span class="muted">Цвет - этап цепочки: распределение, закуп, поставщик. Яркая часть - дни без товара, приглушённая - дни, когда товар закончился.</span>
      </figcaption>
      <div id="chart-causes" class="chart" role="img" aria-label="Столбчатая диаграмма упущенных продаж по причинам"></div>
    </figure>
    <figure class="card chart-card">
      <figcaption>
        <strong>Упущенные продажи по неделям, млн ₽</strong>
        <span class="muted">Неделя - с понедельника. Рост в середине периода - перебои у поставщика, пик в конце сентября - старт продаж iPhone 17.</span>
      </figcaption>
      <div id="chart-weekly" class="chart" role="img" aria-label="Столбчатая диаграмма упущенных продаж по неделям"></div>
    </figure>
    <p>
      <strong>Старт продаж iPhone 17.</strong> Новинки продаются с {fmtDate(L.first_sale)}, но на них пришлось {mln(L.lost)} млн ₽ - {pct(L.lost / total)} всех потерь за период. Неделя с {fmtDate(L.peak_week)} - пик всего периода: {mln(L.peak_lost)} млн ₽ потерь, из них {mln(L.peak_new)} млн - новинки, больше всего {L.top_model}. {lDist > lSup
        ? `Главная причина - не квота поставщика, а распределение: на него приходится ${pct(lDist / L.lost)} потерь по новинкам, на дефицит у поставщика - ${pct(lSup / L.lost)}. ${pct(L.soldout / L.lost)} потерь - дни, когда товар закончился к вечеру: на старте спрос в разы выше обычного, и запаса магазина хватает ненадолго, хотя на складе товар есть. На старт новинки стоит поднимать запасы и частоту пополнения магазинов, а не только объём закупа.`
        : `Главная причина - квота поставщика: на неё приходится ${pct(lSup / L.lost)} потерь по новинкам, на распределение - ${pct(lDist / L.lost)}.`}
    </p>

    <h2>4. Сквозная картина по одному товару</h2>
    <p>
      Один товар на всех этапах сразу - {data.example.sku}. Сверху - сколько закупщик заказал и сколько подтвердил поставщик, в середине - остаток каждого склада, внизу - сколько магазинов этого склада были в дефиците. Видно, как недопоставка и неравномерный закуп доходят до полок: пока один склад пуст, у его магазинов растёт дефицит.
    </p>
    <figure class="card chart-card">
      <figcaption>
        <strong>{data.example.sku}: закуп, склады и магазины</strong>
        <span class="muted">Товар выбран автоматически - на нём встречается больше всего разных причин дефицита.</span>
      </figcaption>
      <div id="chart-chain" class="chart chart-xl" role="img" aria-label="Графики закупа, остатков складов и магазинов в дефиците"></div>
    </figure>

    <h2>5. Хватает ли запасов</h2>
    <p>
      Запас в днях - остаток, делённый на средние продажи в день; для склада - на продажи всех его магазинов. В среднем магазин держит {num(meta.store_cover_days)} дня продаж товара, склад - {num(meta.wh_cover_days)} дня продаж своего региона. Пары «товар - магазин» и «товар - склад» сгруппированы по среднему запасу, и для каждой группы посчитано, как часто товар был в дефиците.
    </p>
    <figure class="card chart-card">
      <figcaption>
        <strong>Доля дней дефицита в зависимости от запаса</strong>
        <span class="muted">Магазин - доля дней, когда товара не было весь день или он закончился; склад - доля дней, когда склад пуст. Под столбцом - доля пар в группе.</span>
      </figcaption>
      <div id="chart-cover" class="chart" role="img" aria-label="Столбчатые диаграммы доли дней дефицита по группам запаса"></div>
    </figure>
    <p>
      Склад с запасом {wc[0].group} продаж региона пуст {pct(wc[0].deficit)} дней, с запасом {wc[1].group} - {pct(wc[1].deficit)}. {whSteep ? `Узкое место - склады с малым запасом: так держится ${pct(wc[0].share)} пар «товар - склад», и именно они чаще всего оставляют магазины без пополнения.` : ''}
    </p>
    <p>
      У магазинов с запасом {sc[0].group} продаж товар в дефиците {pct(sc[0].deficit)} дней, с запасом {scLast.group} - {pct(scLast.deficit)}. {storeFlat ? 'Поднимать запасы магазинов сверх 3-5 дней почти бесполезно: полка пустеет прежде всего тогда, когда пуст склад.' : 'Чем больше запас магазина, тем реже дефицит.'}
    </p>
    <p>
      При этом {pct(meta.soldout_dist_share)} потерь в дни, когда товар закончился за день, пришлись на время, когда товар на складе был: такие магазины можно было пополнить больше или раньше.
    </p>

    <h2>6. Прогноз закупа после дефицита</h2>
    <p>
      Закупщик заказывает по средним отгрузкам склада за три недели. Пока склад пуст, отгрузок нет, прогноз падает - и следующий заказ снова оказывается маленьким: дефицит продлевает сам себя. Такая ошибка исправляется один раз - изменением правила прогноза.
    </p>
    <div class="pair">
      <div class="card stat"><span class="stat-label">Ошибки закупа из-за правила прогноза</span><span class="stat-value">{pct(meta.buy_err_systemic_share)}</span><span class="muted">от {mln(meta.buy_err)} млн ₽ потерь с итогом «ошибка закупа» - без специально заложенных сбоев закупщика</span></div>
    </div>

    <h2>7. Проверка</h2>
    <p>
      В симуляцию заранее заложены проблемы на каждом этапе: перебои у поставщика, недозаказы и перезаказы, неравномерный закуп дефицитного товара, пропуски пополнения магазинов. Разбор о них не знает и находит их только по учётным данным.
    </p>
    <div class="pair">
      <div class="card stat"><span class="stat-label">Верно назван этап цепочки</span><span class="stat-value">{pct(meta.hit)}</span><span class="muted">потерь, за которыми стоит заложенная проблема</span></div>
      <div class="card stat"><span class="stat-label">Оценка упущенных продаж</span><span class="stat-value">{mln(meta.lost_est)} млн ₽</span><span class="muted">истинные по симуляции - {mln(meta.lost_true)} млн ₽</span></div>
    </div>

    <h2>8. Выводы и рекомендации</h2>
    <p>
      Дефицит обошёлся сети примерно в {mln(meta.lost_est)} млн ₽ за три месяца. Из них {pct(distShare)} - распределение между складом и магазинами, {pct(buyShare)} - закуп, {pct(supShare)} - нехватка у поставщика. Значит, большую часть потерь сеть может сократить сама, без изменений у поставщика.
    </p>
    <section class="card summary recs">
      <ol>
        <li><strong>Пополнять магазины, пока на складе есть товар.</strong> Распределение - самая дорогая причина: {pct(distShare)} потерь. {pct(meta.soldout_dist_share)} потерь в дни, когда товар закончился к вечеру, пришлись на время, когда он лежал на складе. Нужен ежедневный отчёт «на складе есть - в магазине пусто или почти пусто» и более частое пополнение быстро продающихся позиций. Запас поднимать не везде, а там, где его меньше 3 дней продаж: в этой группе дефицит {pct(sc[0].deficit)} дней против {pct(sc[1].deficit)} при 3-5 днях.</li>
        <li><strong>Держать на складах запас хотя бы на 5-7 дней продаж региона.</strong> Склад с запасом до 5 дней пуст {pct(wc[0].deficit)} дней, с запасом 5-7 дней - {pct(wc[1].deficit)}. Сейчас так мало держится {pct(wc[0].share)} пар «товар - склад»: это точечное изменение закупа по этим позициям, а не рост всех запасов.</li>
        <li><strong>Изменить правило прогноза закупа.</strong> Прогноз по отгрузкам склада после дефицита занижает следующий заказ - так объясняется {pct(meta.buy_err_systemic_share)} потерь с итогом «ошибка закупа». Прогноз стоит строить по продажам магазинов региона в дни, когда товар был, - тогда пустой склад не будет уменьшать заказ.</li>
        <li><strong>Готовить старт новинок отдельно.</strong> Новинки дали {pct(L.lost / total)} всех потерь за несколько недель продаж. На первые две недели после старта - повышенный запас в магазинах и пополнение по фактическому ажиотажному спросу, а не по обычному плану.</li>
        <li><strong>Делить дефицитный товар между складами по спросу.</strong> Когда поставщик даёт меньше заказа, перекос закупа стоил {mln(buySkewLost)} млн ₽: один регион получал с запасом, другой оставался пустым. При недопоставке подтверждённый объём стоит распределять пропорционально продажам регионов.</li>
        <li><strong>Сделать разбор регулярным.</strong> Расчёт работает на данных, которые уже есть в учётной системе. Еженедельная тепловая карта дефицита и разбор причин показывают, кому ставить задачу - закупке, складу или переговорам с поставщиком, - и позволяют проверить, дали ли изменения эффект.</li>
      </ol>
    </section>

    <p class="actions">
      <a class="btn primary" href={codeUrl}>Ноутбук на GitHub</a>
    </p>
  </article>
</Base>

<style>
  .flowline {
    display: flex;
    align-items: stretch;
    gap: 8px;
    margin: 12px 0 18px;
  }

  .flowline .node {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 10px 12px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    font-size: 0.9rem;
  }

  .flowline .link {
    flex: 0.8;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    font-size: 0.8rem;
  }

  .flowline .link span:first-child {
    font-size: 1.4rem;
    color: var(--muted);
    line-height: 1;
  }

  .decision {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px;
    margin: 12px 0 20px;
  }

  .decision .start {
    align-self: flex-start;
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--surface-2);
    font-weight: 700;
    font-size: 0.9rem;
  }

  .decision .step {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 10px;
    align-items: stretch;
  }

  .decision .q {
    display: flex;
    gap: 8px;
    align-items: flex-start;
    padding: 8px 10px;
    border: 1px solid var(--border);
    border-radius: 8px;
    font-size: 0.9rem;
  }

  .decision .n {
    flex: none;
    width: 1.4rem;
    height: 1.4rem;
    border-radius: 50%;
    background: var(--surface-2);
    text-align: center;
    font-size: 0.8rem;
    font-weight: 700;
    line-height: 1.4rem;
  }

  .decision .out {
    display: flex;
    flex-direction: column;
    gap: 1px;
    padding: 8px 10px;
    border-left: 4px solid var(--muted);
    border-radius: 8px;
    background: var(--surface-2);
    font-size: 0.85rem;
  }

  .decision .out.dist {
    border-left-color: var(--series-tesera);
  }

  .decision .out.buy {
    border-left-color: var(--series-bgg);
  }

  .decision .out .yes {
    color: var(--muted);
    font-size: 0.75rem;
  }

  .decision .no {
    color: var(--muted);
    font-size: 0.8rem;
    padding-left: 12px;
  }

  .decision .last {
    align-self: flex-start;
  }

  .heat-wrap {
    overflow-x: auto;
  }

  .heat {
    border-collapse: separate;
    border-spacing: 2px;
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }

  .heat th,
  .heat td {
    padding: 4px 3px;
    text-align: center;
    white-space: nowrap;
  }

  .heat td {
    min-width: 30px;
    border-radius: 4px;
  }

  .heat thead th {
    color: var(--muted);
    font-weight: 400;
  }

  .heat tbody th {
    position: sticky;
    left: 0;
    z-index: 1;
    background: var(--surface);
    text-align: left;
    font-weight: 400;
  }

  .heat .wh th button {
    all: unset;
    cursor: pointer;
    font-weight: 700;
  }

  .heat .wh th button:focus-visible {
    outline: 2px solid var(--accent);
    border-radius: 4px;
  }

  .heat .caret {
    display: inline-block;
    width: 1em;
    transition: transform 0.15s;
  }

  .heat button[aria-expanded='true'] .caret {
    transform: rotate(90deg);
  }

  .heat .store th {
    padding-left: 18px;
    color: var(--muted);
  }

  .recs ol {
    margin: 0;
    padding-left: 1.2rem;
  }

  .recs li + li {
    margin-top: 8px;
  }

  .chart-xl {
    height: 560px;
  }

  @media (max-width: 560px) {
    .flowline {
      flex-direction: column;
    }

    .flowline .link span:first-child {
      transform: rotate(90deg);
    }

    .decision .step {
      grid-template-columns: 1fr;
