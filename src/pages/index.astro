---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { profile } from '../data/profile';
import { projects } from '../data/projects';

const contacts = [
  { label: 'Telegram @Kobcev', href: profile.contacts.telegram },
  { label: 'kobtsev.victor@yandex.ru', href: profile.contacts.email },
  { label: 'GitHub', href: profile.github },
].filter((c) => c.href);
---

<Base>
  <section class="hero">
    <span class="badge ok">{profile.status}</span>
    <h1>{profile.name} - {profile.role}</h1>
    {profile.about.map((p) => <p class="lead">{p}</p>)}
    <p class="lead">Открыт к сотрудничеству, подробнее о моём опыте <a href="/about">тут</a>.</p>
    <ul class="tags">
      {profile.skills.map((s) => <li>{s}</li>)}
    </ul>
  </section>

  <section id="projects">
    <h2>Проекты</h2>
    <div class="grid">
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>

  <section id="benefits">
    <h2>Форматы сотрудничества</h2>
    <div class="grid">
      <div class="card">
        <h3>Аналитика с нуля без найма отдела</h3>
        <p class="muted">Один фулстек-аналитик закрывает первый этап дешевле и быстрее, чем выстраивание команды с нуля.</p>
      </div>
      <div class="card">
        <h3>Проектная работа по договору</h3>
        <p class="muted">Внедрение конкретного решения - дашборд, пайплайн, модель - без обязательств по постоянному найму.</p>
      </div>
      <div class="card">
        <h3>Усиление действующей команды</h3>
        <p class="muted">Роль тимлида/сеньора, если команда аналитиков уже есть, но не хватает архитектуры процессов или экспертизы уровня «построил с нуля».</p>
      </div>
    </div>
  </section>

  <section id="contacts">
    <h2>Контакты</h2>
    <div class="contacts">
      {contacts.map((c) => <a class="btn" href={c.href!}>{c.label}</a>)}
    </div>
  </section>
</Base>

<style>
  .hero .lead {
    margin: 0.5rem 0;
  }

  .hero h1 {
    margin-top: 12px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: 16px;
  }

  .contacts {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
</style>
